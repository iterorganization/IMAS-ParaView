      <Property name="Script" id="22716.Script" number_of_elements="1">
        <Element index="0" value="import numpy as np&#xa;import vtk&#xa;from vtkmodules.util import numpy_support as nps&#xa;&#xa;pdi = self.GetInputDataObject(0, 0)&#xa;pdo = self.GetOutput()&#xa;pdo.Initialize()&#xa;&#xa;pd = pdi.GetPointData()&#xa;&#xa;r = nps.vtk_to_numpy(pd.GetArray(&#x22;r&#x22;))&#xa;z = nps.vtk_to_numpy(pd.GetArray(&#x22;z&#x22;))&#xa;&#xa;wt_array = pd.GetArray(&#x22;weights&#x22;)&#xa;weights = nps.vtk_to_numpy(wt_array)&#xa;bins_r, bins_z = 100, 100&#xa;H, r_edges, z_edges = np.histogram2d(&#xa;    r, z,&#xa;    bins=[bins_r, bins_z],&#xa;    weights=weights&#xa;)&#xa;&#xa;dr = np.diff(r_edges)                    &#xa;dz = np.diff(z_edges)                  &#xa;r_centers = 0.5 * (r_edges[:-1] + r_edges[1:]) &#xa;&#xa;V = (2.0 * np.pi) * r_centers[:, None] * dr[:, None] * dz[None, :]&#xa;&#xa;mask_pos = V &#x3e; 0&#xa;if np.any(mask_pos):&#xa;    V[~mask_pos] = np.min(V[mask_pos])&#xa;else:&#xa;    return&#xa;&#xa;&#xa;density = H / V&#xa;&#xa;pos = density &#x3e; 0&#xa;if np.any(pos):&#xa;    density[~pos] = np.min(density[pos])&#xa;&#xa;pdo.SetDimensions(bins_r + 1, bins_z + 1, 1)&#xa;pdo.SetExtent(0, bins_r, 0, bins_z, 0, 0)&#xa;&#xa;pdo.SetXCoordinates(nps.numpy_to_vtk(r_edges, deep=True))&#xa;pdo.SetYCoordinates(nps.numpy_to_vtk(z_edges, deep=True))&#xa;pdo.SetZCoordinates(nps.numpy_to_vtk(np.array([0.0]), deep=True))&#xa;&#xa;density_flat = np.asarray(density.T, order=&#x27;F&#x27;).ravel()&#xa;&#xa;vtk_arr = nps.numpy_to_vtk(density_flat, deep=True)&#xa;vtk_arr.SetName(&#x22;density [$m^{-3}$]&#x22;)&#xa;&#xa;pdo.GetCellData().SetScalars(vtk_arr)"/>
      </Property>
