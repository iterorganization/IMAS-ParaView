        <Element index="0" value="import numpy as np&#xa;import vtk&#xa;from vtkmodules.util import numpy_support as nps&#xa;&#xa;m_e = 9.1093837e-31  # Electron mass in kg&#xa;c = 299792458.0      # Speed of light in m/s&#xa;&#xa;pdi = self.GetInputDataObject(0, 0)&#xa;pdo = self.GetOutput()&#xa;pdo.Initialize()&#xa;&#xa;pd = pdi.GetPointData()&#xa;&#xa;p_raw = nps.vtk_to_numpy(pd.GetArray(&#x22;momentum&#x22;))&#xa;xi = nps.vtk_to_numpy(pd.GetArray(&#x22;pitch&#x22;))&#xa;weights = nps.vtk_to_numpy(pd.GetArray(&#x22;weights&#x22;))&#xa;&#xa;p = p_raw / (m_e * c)&#xa;&#xa;bins_p, bins_xi = 100, 100&#xa;&#xa;H, p_edges, xi_edges = np.histogram2d(&#xa;    p, xi,&#xa;    bins=[bins_p, bins_xi],&#xa;    weights=weights&#xa;)&#xa;&#xa;dp = np.diff(p_edges)&#xa;dxi = np.diff(xi_edges)&#xa;&#xa;density = H / (dp[:, None] * dxi[None, :])&#xa;pdo.SetDimensions(bins_p + 1, bins_xi + 1, 1)&#xa;pdo.SetExtent(0, bins_p, 0, bins_xi, 0, 0)&#xa;&#xa;pdo.SetXCoordinates(nps.numpy_to_vtk(p_edges, deep=True))&#xa;pdo.SetYCoordinates(nps.numpy_to_vtk(xi_edges, deep=True))&#xa;pdo.SetZCoordinates(nps.numpy_to_vtk(np.array([0.0]), deep=True))&#xa;&#xa;density_flat = density.T.ravel(order=&#x27;C&#x27;)&#xa;&#xa;vtk_arr = nps.numpy_to_vtk(density_flat, deep=True)&#xa;vtk_arr.SetName(&#x22;Phase-space density&#x22;)&#xa;&#xa;pdo.GetCellData().AddArray(vtk_arr)"/>
      </Property>
